# GoMuseum 生产环境变量（复制为 .env 并填写）
ENVIRONMENT=production
DEBUG=false

# openssl rand -hex 48 生成
SECRET_KEY=

POSTGRES_USER=gomuseum
POSTGRES_PASSWORD=
POSTGRES_DB=gomuseum

# CORS（移动端不受 CORS 限制，此处配置官网/管理后台域名）
ALLOWED_ORIGINS=https://gomuseum.app

OPENAI_API_KEY=
# 懒生成 TTS(Google Chirp 3 HD);只允许 Text-to-Speech API + VPS IP。合代码前先配好
GOOGLE_TTS_API_KEY=
ANTHROPIC_API_KEY=

OPENAI_DAILY_CALL_LIMIT=2000

# ── 发信(找回密码 / 邮箱验证)─────────────────────────────────────────
# ⚠️ 不配 = **没有找回密码**(端点返 503)。用邮箱密码注册的用户忘了密码就
# 永久登不进去,而通票挂在账号上 —— 付了钱的人拿不回自己买的东西。
# Resend / SendGrid / Mailgun / Postmark 都给 SMTP,填哪家都行。
# 发信域名要配好 SPF/DKIM,否则会进垃圾箱 —— 那和没发出去是一个效果。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=GoMuseum <noreply@gomuseum.app>

# 邮件里链接的根地址。重置页由 API 自己吐(同源、免 CORS、免发网站),
# 所以这里填 API 的外网地址,不是官网。
PUBLIC_API_BASE_URL=https://api.gomuseum.app

# ── Play 退款通知(RTDN)入口鉴权 ────────────────────────────────────────
# audience = 建推送订阅时填的那个字符串;SA = 该订阅的「服务账号」邮箱。
# 两个都配上,/payment/rtdn 才认 OIDC。缺任一都按未配置处理(半验当没验)。
PLAY_RTDN_AUDIENCE=https://api.gomuseum.app/api/v1/payment/rtdn
PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=

# 老方案:URL 上的共享密钥。⚠️ 它会明文写进 nginx/uvicorn 的 access log。
# 切换顺序**不能反**:
#   1) 部署带 OIDC 的后端(此时两条路都通)
#   2) 到 Cloud Console 把 RTDN 推送订阅改成「启用身份验证」,选服务账号、
#      填上面那个 audience
#   3) 确认真的收得到通知(日志里不再出现「RTDN 仍在用 URL 共享密钥」)
#   4) 才清空下面这行并轮换旧密钥
# 先清空再改订阅 = 这中间的退款通知全被 403 拒收,Pub/Sub 重试若干天后丢弃,
# 退款不撤权益 —— 又变回持续漏钱。
PLAY_RTDN_TOKEN=

# ── 弹性扩容阶段 0(spec 2026-10-21-elastic-scaling-design;运维见 docs/ops/capacity-runbook.md)──
# 下面都是代码里的默认值,不写就用默认;改了要重启后端。
# LAZY_CONCURRENCY=2              # 每进程同时懒生成/懒翻译件数(阶段 1 改 4)
# LAZY_FANOUT_CONCURRENCY=2       # 每进程同时补语言件数(阶段 1 改 4)
# GUEST_LOGIN_RATE=30/hour        # 游客登录每 IP 限速(每进程计数)
# LLM_TIMEOUT_S=90                # 大模型调用没给超时时的读写秒数(连接 5 秒)
# CAP_PER_USER=160                # 懒生成每账号每日额度(段)
# CAP_PER_IP=300                  # 游客每 IP 每日额度(段)
# CAP_PER_IP_REGISTERED=600       # 正式账号每 IP 每日额度(段,与游客分开计数)
# LLM_PRICES={}                   # 只写要补或要改的模型,和代码默认价目表合并,如 {"gpt-7": [5, 20]}
# BUDGET_GEN_DAILY_USD=30         # 内容生成每日预算(阶段 0 只告警)
# BUDGET_GEN_MONTHLY_USD=300      # 内容生成每月预算(阶段 0 只告警)
# BUDGET_ALERT_RATIO=0.8          # 到预算的这个比例先告警一次
# ALERT_TTS_DAILY_USD=2           # 语音每日告警线;0 = 关闭;阶段 2 前按实际量重标
# ALERT_RECOG_DAILY_USD=0         # 识别兜底每日告警线;0 = 关闭;上 prod 7 天后定
