# GoMuseum 生产环境变量（复制为 .env 并填写）
ENVIRONMENT=production
DEBUG=false

# openssl rand -hex 48 生成
SECRET_KEY=

POSTGRES_USER=gomuseum
POSTGRES_PASSWORD=
POSTGRES_DB=gomuseum

# CORS（移动端不受 CORS 限制，此处配置官网/管理后台域名）
ALLOWED_ORIGINS=https://gomuseum.app

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

OPENAI_DAILY_CALL_LIMIT=2000

# ── 发信(找回密码 / 邮箱验证)─────────────────────────────────────────
# ⚠️ 不配 = **没有找回密码**(端点返 503)。用邮箱密码注册的用户忘了密码就
# 永久登不进去,而通票挂在账号上 —— 付了钱的人拿不回自己买的东西。
# Resend / SendGrid / Mailgun / Postmark 都给 SMTP,填哪家都行。
# 发信域名要配好 SPF/DKIM,否则会进垃圾箱 —— 那和没发出去是一个效果。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=GoMuseum <noreply@gomuseum.app>

# 邮件里链接的根地址。重置页由 API 自己吐(同源、免 CORS、免发网站),
# 所以这里填 API 的外网地址,不是官网。
PUBLIC_API_BASE_URL=https://api.gomuseum.app

# ── Play 退款通知(RTDN)入口鉴权 ────────────────────────────────────────
# audience = 建推送订阅时填的那个字符串;SA = 该订阅的「服务账号」邮箱。
# 两个都配上,/payment/rtdn 才认 OIDC。缺任一都按未配置处理(半验当没验)。
PLAY_RTDN_AUDIENCE=https://api.gomuseum.app/api/v1/payment/rtdn
PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=

# 老方案:URL 上的共享密钥。⚠️ 它会明文写进 nginx/uvicorn 的 access log。
# 切换顺序**不能反**:
#   1) 部署带 OIDC 的后端(此时两条路都通)
#   2) 到 Cloud Console 把 RTDN 推送订阅改成「启用身份验证」,选服务账号、
#      填上面那个 audience
#   3) 确认真的收得到通知(日志里不再出现「RTDN 仍在用 URL 共享密钥」)
#   4) 才清空下面这行并轮换旧密钥
# 先清空再改订阅 = 这中间的退款通知全被 403 拒收,Pub/Sub 重试若干天后丢弃,
# 退款不撤权益 —— 又变回持续漏钱。
PLAY_RTDN_TOKEN=
